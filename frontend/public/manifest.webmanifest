{
  "name": "Android Web IDE",
  "short_name": "App Builder",
  "description": "Self-hosted Android project editor and APK builder",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#101319",
  "theme_color": "#101319",
  "icons": [
